# Copy to .env and fill in your values. Never commit .env.

# Azure OpenAI — chat model (needed to run the shell)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-key-here
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini

# For hosted deployments, set this to the JSON contents of data/credentials.json.
# CREDENTIALS_JSON={"CO001":{"password_sha256":"..."}}
# ANTHROPIC_API_KEY=your-key-here
# ANTHROPIC_BASE_URL=https://your-anthropic-endpoint/anthropic

# Embedding model — you'll need this once you add RAG.
# AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small
